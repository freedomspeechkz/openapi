            },
            "description": "До 50 строк. Ответ: detections[{text, detected_source_language}].",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": [\n    \"Сәлем\",\n    \"Hello\",\n    \"Привет\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
